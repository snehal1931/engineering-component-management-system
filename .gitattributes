# Normalize line endings to LF in the repository for cross-platform compatibility
* text=auto eol=lf

# Java source files
*.java text eol=lf
*.xml  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sql  text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.properties text eol=lf

# Binary files — do not modify
*.jar  binary
*.class binary
*.png  binary
*.jpg  binary
